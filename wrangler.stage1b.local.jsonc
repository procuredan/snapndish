{
  "name": "snapndish-stage1b-local",
  "main": "live-lab/worker.mjs",
  "compatibility_date": "2026-06-24",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "snapndish-stage1b-local",
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "stage1b/migrations"
  }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "snapndish-stage1b-local-images" }],
  "vars": {
    "STAGE1B_ENABLED": "true",
    "MODEL": "gpt-6-astra",
    "REASONING_EFFORT": "medium",
    "BEHAVIOR_VERSION": "stage1a-snap-v2",
    "ARM": "C"
  }
}
